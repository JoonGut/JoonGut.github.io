---
export interface EstudiosItemProps {
    date: string;
    title: string;
    center?: string;
    description?: string | string[];
}
const { date, title, center, description } = Astro.props;
const points = description
    ? Array.isArray(description) ? description : [description]
    : [];
---
<div class="absolute w-3 h-3 bg-blue-600 rounded-full mt-1.5 -start-1.5 border border-white/10"></div>
<time class="text-xs font-normal leading-none text-neutral-400 sm:text-sm">{date}</time>
<h3 class="text-base font-semibold text-white my-2 break-words sm:text-lg">{title}</h3>
{center && (
    <p class="mb-3 text-sm text-neutral-400 sm:text-base">{center}</p>
)}

