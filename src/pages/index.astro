---
import Layout from '../layouts/Layout.astro';
import Badge from '../components/Badge.astro';
import LinkedInIcon from'../components/icons/LinkedInIcon.astro';
import GithubIcon from'../components/icons/GithubIcon.astro';
import GmailIcon from'../components/icons/GmailIcon.astro';
import Experiencia from '../components/Experiencia.astro';
import Proyectos from '../components/Proyectos.astro';
import Briefcase from '../components/icons/Briefcase.astro';
import Code from '../components/icons/Code.astro';
---

<Layout title="Porfolio de Jon Gutierrez - Desarrollador de Sofware e Inteligencia Artificial - Analista de datos">
	<main>
		<section id = "top" class="w-full max-w-[740px] mx-auto px-4 py-8 sm:px-6 sm:py-10">
			<h1 class="flex flex-wrap items-center justify-center gap-3 text-white text-3xl font-bold sm:text-4xl md:text-5xl">Kaixo, soy Jon!<a href="https://www.linkedin.com/in/jon-gutierrez-rodr%C3%ADguez-78096937b/" target="_blank" rel="noopener noreferrer"> <Badge>Disponible para trabajar</Badge></a></h1>
			<h2 class="mt-4 text-center text-lg text-neutral-300 sm:text-xl">Desarrollador de software e inteligencia artificial</h2>
			<ul class="mt-6 flex flex-wrap items-center justify-center gap-3">
				<li><a href="https://www.linkedin.com/in/jon-gutierrez-rodr%C3%ADguez-78096937b/" class="inline-flex h-10 items-center gap-2 rounded-full border border-white/10 bg-white/5 px-4 text-sm text-neutral-300 transition-transform duration-200 hover:-translate-y-1 hover:bg-white/10" target="_blank" rel="noopener noreferrer"><LinkedInIcon class="w-4 h-4" /> LinkedIn</a></li>
				<li><a href="https://github.com/JoonGut" class="inline-flex h-10 items-center gap-2 rounded-full border border-white/10 bg-white/5 px-4 text-sm text-neutral-300 transition-transform duration-200 hover:-translate-y-1 hover:bg-white/10" target="_blank" rel="noopener noreferrer"><GithubIcon class="w-4 h-4" /> GitHub</a></li>
				<li><a href="mailto:gutijon48@gmail.com" class="inline-flex h-10 items-center gap-2 rounded-full border border-white/10 bg-white/5 px-4 text-sm text-neutral-300 transition-transform duration-200 hover:-translate-y-1 hover:bg-white/10"><GmailIcon class="w-4 h-4" /> Correo electrónico</a></li>
		</ul>
		</section>
		<section class="w-full max-w-[740px] mx-auto px-4 py-4 sm:px-6 sm:py-6">
			<div id = "experiencia" class="mt-2 sm:mt-4 lg:mt-6">
				<h2 class="text-2xl font-bold text-white mb-4 flex gap-x-2 items-center sm:text-3xl">
					<Briefcase class="size-6" /> Experiencia laboral
				</h2>
				<br />
				<Experiencia />
			</div>
		</section>
		<section class="w-full max-w-[740px] mx-auto px-4 py-8 sm:px-6 sm:py-10">
			<div id = "proyectos" class="mt-4 sm:mt-6 lg:mt-10">
				<h2 class="text-2xl font-bold text-white mb-4 flex gap-x-2 items-center sm:text-3xl">
					<Code class="size-6" /> Proyectos
				</h2>
				<br />
				<Proyectos />
			</div>
		</section>
	</main>
</Layout>
