---
import Layout from '../layouts/Layout.astro';
import Badge from '../components/Badge.astro';
---

<Layout>
	<main>
		<section class="w-full max-w-[740px] mx-auto py-10">
			<h1 class="flex flex-wrap items-center justify-center gap-3 text-white text-5xl font-bold">Hey, soy Jon! <Badge>Disponible para trabajar</Badge></h1>
			<h2 class="mt-4 text-center text-xl text-neutral-300">Desarrollador web y diseñador de experiencia de usuario</h2>
			<ul>
				<li>Desarrollo de aplicaciones web y móviles</li>
				<li>Diseño de interfaces y experiencia de usuario</li>
				<li>Optimización de rendimiento y SEO</li>
		</ul>
		</section>
	</main>
</Layout>
